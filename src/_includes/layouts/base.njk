{%- from "partials/icons.njk" import icon -%}
<!doctype html>
<html lang="de">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ title }} · {{ site.name }}</title>
	<meta name="description" content="{{ description or site.tagline }}">
	<link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
	<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
	<a class="skip-link" href="#main">Zum Inhalt springen</a>

	<header class="site-header">
		<div class="wrap site-header__bar">
			<a class="site-header__logo" href="{{ '/' | url }}">{{ site.name }}</a>
			<span class="dot-divider" aria-hidden="true"></span>

			<button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="main-nav">
				<span class="nav-toggle__label">Menü</span>
				<span class="nav-toggle__icon" aria-hidden="true"></span>
			</button>

			<nav class="site-nav" id="main-nav" aria-label="Hauptnavigation">
				<ul>
					{% for item in site.nav %}
					<li><a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
					{% endfor %}
				</ul>
			</nav>
		</div>
	</header>

	<main id="main">
		{{ content | safe }}
	</main>

	<footer class="site-footer">
		<div class="wrap site-footer__grid">
			<div>
				<p class="site-footer__brand">{{ site.name }}</p>
				<p>{{ site.address.street }}<br>{{ site.address.zip }} {{ site.address.city }}</p>
			</div>
			<div>
				<p><a class="footer-contact-link" href="tel:{{ site.phone }}">{{ icon("phone") }}<span>{{ site.phoneDisplay }}</span></a></p>
				<p><a class="footer-contact-link" href="mailto:{{ site.email }}">{{ icon("mail") }}<span>{{ site.email }}</span></a></p>
			</div>
			<div class="site-footer__legal">
				<ul>
					{% for item in site.footerNav %}
					<li><a href="{{ item.url | url }}">{{ item.text }}</a></li>
					{% endfor %}
				</ul>
				<p>&copy; {{ "now" | currentYear }} {{ site.name }}</p>
			</div>
		</div>
	</footer>

	<script src="{{ '/js/nav.js' | url }}"></script>
	{% if page.url == "/galerie/" %}<script src="{{ '/js/gallery.js' | url }}" defer></script>{% endif %}
</body>
</html>
