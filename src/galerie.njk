---
layout: layouts/base.njk
title: Galerie
description: Nageldesign-Galerie von Priema Nageldesign – Schmuck, Schuhe, Muster und weitere Arbeiten.
---
<section class="section">
	<div class="wrap">
		<h1>Galerie</h1>
		<p class="hero__lead">Ein Einblick in meine Arbeiten – nach Kategorie sortiert.</p>

		<div class="gallery-tabs" role="tablist" aria-label="Galerie-Kategorien">
			<button role="tab" id="tab-all-incl" aria-controls="panel-all-incl" aria-selected="true" data-tab="all-incl">All Incl.</button>
			<button role="tab" id="tab-dezent" aria-controls="panel-dezent" aria-selected="false" tabindex="-1" data-tab="dezent">Dezent</button>
			<button role="tab" id="tab-schmuck" aria-controls="panel-schmuck" aria-selected="false" tabindex="-1" data-tab="schmuck">Schmuck</button>
			<button role="tab" id="tab-schuhe" aria-controls="panel-schuhe" aria-selected="false" tabindex="-1" data-tab="schuhe">Schuhe</button>
			<button role="tab" id="tab-muster" aria-controls="panel-muster" aria-selected="false" tabindex="-1" data-tab="muster">Muster</button>
		</div>

		<div class="gallery-panel is-active" id="panel-all-incl" role="tabpanel" aria-labelledby="tab-all-incl" data-panel="all-incl">
			<div class="gallery-placeholder">
				<h3>Diese Galerie wird bald live verbunden</h3>
				<p>Die "All Incl."-Arbeiten zeigen wir hier demnächst automatisch über einen Instagram/Facebook-Feed – schaut in der Zwischenzeit gerne auf <a href="{{ site.facebookUrl }}" target="_blank" rel="noopener">unserer Facebook-Seite</a> vorbei.</p>
				<div id="gallery-feed-allincl"></div>
			</div>
		</div>

		<div class="gallery-panel" id="panel-dezent" role="tabpanel" aria-labelledby="tab-dezent" data-panel="dezent" hidden>
			<div class="gallery-placeholder">
				<h3>Diese Galerie wird bald live verbunden</h3>
				<p>Die "Dezent"-Arbeiten zeigen wir hier demnächst automatisch über einen Instagram/Facebook-Feed – schaut in der Zwischenzeit gerne auf <a href="{{ site.facebookUrl }}" target="_blank" rel="noopener">unserer Facebook-Seite</a> vorbei.</p>
				<div id="gallery-feed-dezent"></div>
			</div>
		</div>

		<div class="gallery-panel" id="panel-schmuck" role="tabpanel" aria-labelledby="tab-schmuck" data-panel="schmuck" hidden>
			<div class="photo-grid">
				{% for i in range(1, 38) %}
				<button type="button" data-full="{% imageUrl "schmuck/schmuck-" + (i | pad2) + ".jpg", 1600 %}">
					{% image "schmuck/schmuck-" + (i | pad2) + ".jpg", "Schmuck-Nageldesign " + i, "220px" %}
				</button>
				{% endfor %}
			</div>
		</div>

		<div class="gallery-panel" id="panel-schuhe" role="tabpanel" aria-labelledby="tab-schuhe" data-panel="schuhe" hidden>
			<div class="photo-grid">
				{% for i in range(1, 6) %}
				<button type="button" data-full="{% imageUrl "schuhe/schuhe-" + (i | pad2) + ".jpg", 1600 %}">
					{% image "schuhe/schuhe-" + (i | pad2) + ".jpg", "Handbemalte Schuhe " + i, "220px" %}
				</button>
				{% endfor %}
			</div>
		</div>

		<div class="gallery-panel" id="panel-muster" role="tabpanel" aria-labelledby="tab-muster" data-panel="muster" hidden>
			<div class="photo-grid">
				{% for i in range(1, 6) %}
				<button type="button" data-full="{% imageUrl "muster/muster-" + (i | pad2) + ".jpg", 1600 %}">
					{% image "muster/muster-" + (i | pad2) + ".jpg", "Nagel-Muster " + i, "220px" %}
				</button>
				{% endfor %}
			</div>
		</div>
	</div>
</section>

<section class="section section--alt">
	<div class="wrap">
		<h2>Video</h2>
		<div class="video-embed">
			<iframe src="https://www.youtube-nocookie.com/embed/9mSWMJ9v8o4" title="Priema Nageldesign Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
		</div>
	</div>
</section>

<div class="lightbox" id="lightbox">
	<button class="lightbox__close" id="lightbox-close" aria-label="Schließen">&times;</button>
	<img id="lightbox-img" src="" alt="">
</div>
